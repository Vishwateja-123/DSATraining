2)Range Sum Query

   def __init__(self, nums: List[int]):
        self.n=len(nums)
        self.tree=[0]*4*self.n
        self.build(0,0,self.n-1,nums)
    
    def build(self,node,start,end,nums):
        if start==end:
            self.tree[node]=nums[start]
            return
        mid=(start+end)//2
        self.build(2*node+1,start,mid,nums)
        self.build(2*node+2,mid+1,end,nums)
        self.tree[node]=self.tree[2*node+1]+self.tree[2*node+2]
    

    def sumRange(self, left: int, right: int) -> int:
        return self.query(0,0,self.n-1,left,right)

    def query(self, node, start, end, left, right):
        #No overlap
        if start > right  or end<left:
            return 0
        
        #complete overlap
        if left<=start and end <=right:
            return self.tree[node]

        #partial overlap
        mid=(start+end)//2
        leftValue=self.query(2*node+1,start,mid,left,right)
        rightValue=self.query(2*node+2,mid+1,end,left,right)
        return leftValue+rightValue

